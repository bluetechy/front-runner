########################################################################
# SHARED ENVIRONMENT FOR docker-compose-dev.yml
#
# Committed on purpose so a clone comes up with no extra setup. These are
# local development credentials only - never reuse them anywhere real.
########################################################################

########################################################################
# POSTGRES SUPERUSER (consumed by the postgres image entrypoint)
########################################################################

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=admin

########################################################################
# APPLICATION DATABASE (consumed by apps/main-db/init.sh)
#
# The names below are hard-coded throughout apps/main-db/sql, so changing
# them here means changing them there too.
########################################################################

APP_DB_NAME=dbo
APP_DB_USER=root
APP_DB_PASSWORD=root

########################################################################
# SERVICE ADDRESSES AND PUBLISHED PORTS
########################################################################

POSTGRES_ADDRESS=main-db
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=30002

REDIS_ADDRESS=main-kvs
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=30001

API_PORT=3000
API_PUBLISHED_PORT=30000

GUI_PORT=5173
GUI_PUBLISHED_PORT=80

# client-gui, the page that renders a published widget the way a customer's site
# would. It runs on the host rather than in Compose, and the port matters: it is
# a *different origin* from main-gui, which is the whole point of the app, and it
# is the origin a widget's definition has to list under delivery.allowedOrigins
# before a browser there may render it. See apps/client-gui/README.md.
CLIENT_GUI_PORT=5174

KEYCLOAK_ADDRESS=keycloak-idp
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLISHED_PORT=30003

########################################################################
# IDENTITY PROVIDER
#
# Two blocks, and the split is deliberate. IDP_ and VITE_IDP_ are what any
# OpenID Connect provider has to tell main-api and the browser, and are all
# either of them knows; KEYCLOAK_ below is this one provider's own
# configuration, read by nothing but KeycloakAdminService and the container
# itself. Moving to another provider replaces the second block and leaves the
# first pointing somewhere new. See
# apps/main-api/src/authentication/identity-admin.service.ts.
#
# IDP_ISSUER_URL is the address the browser logs in at, and is what appears in
# the token. IDP_JWKS_URL is where main-api fetches the signing keys from,
# inside the Compose network. They are different addresses for the same server
# and both are needed; Compose builds each from the values below.
########################################################################

# The client id this API is an audience for, and, because they are the same
# client, the id it authenticates to the admin API with.
IDP_AUDIENCE=main-api

########################################################################
# KEYCLOAK (this installation's provider)
#
# The realm is imported from apps/keycloak-idp/realm on first start, along
# with a development account per seeded user whose password is their username.
# Keycloak keeps its own database beside "dbo" in main-db.
########################################################################

KEYCLOAK_REALM=front-runner

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# What main-api authenticates to Keycloak's admin API as, to change the
# address somebody logs in with when they make one primary on the security
# page. It is the "main-api" client's own service account, not the bootstrap
# admin above: the service account holds exactly manage-users, view-users,
# view-events and view-identity-providers on this realm, and the bootstrap
# admin holds everything.
#
# Development value only. A real deployment generates one and keeps it out of
# the repository; the realm import carries the same literal, so the two have
# to be changed together.
KEYCLOAK_CLIENT_SECRET=dev-main-api-client-secret

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

########################################################################
# BROWSER CONFIGURATION (consumed by apps/main-gui through Vite)
#
# Only VITE_-prefixed keys reach the bundle, and everything here is a public
# address the browser has to know anyway. The issuer is the published address,
# not the Compose one: this is what the browser dials, and it is also what ends
# up in the token's issuer.
#
# The issuer is all the browser is told. Every endpoint it uses comes from that
# address's /.well-known/openid-configuration, so a change of provider is a
# change to these three lines. See apps/main-gui/src/authentication.
########################################################################

VITE_IDP_ISSUER_URL=http://localhost:30003/realms/front-runner
VITE_IDP_CLIENT_ID=main-gui
# Which query parameter names a login provider to go straight on to, for the
# Google, Facebook and Apple buttons. Keycloak calls it kc_idp_hint; other
# providers spell it differently, and an empty value turns the buttons into
# plain trips to the hosted login page.
VITE_IDP_HINT_PARAMETER=kc_idp_hint
# Where the provider runs its own account-linking flow, which is what the
# security page's Connect button hands the browser to. {provider} is the alias.
# This is the one address the browser uses that OpenID Connect does not
# publish: linking an account is nobody's standard, so it is configuration
# rather than discovery, and an empty value turns Connect off and leaves the
# card reading only.
VITE_IDP_LINK_PATH=/broker/{provider}/link
# Which query parameter asks the provider to run something while the browser is
# there rather than only signing somebody in, and what it calls the one that
# sets up an authenticator app. Keycloak spells them kc_action and
# CONFIGURE_TOTP. This is how the security page turns two-factor authentication
# on: the secret behind an authenticator app is minted by the provider and
# shown once, as a QR code on its own page, so no admin API can hand it over
# and the browser has to go there. Either value empty turns the Enable button
# off and leaves the card reading only.
VITE_IDP_ACTION_PARAMETER=kc_action
VITE_IDP_TOTP_ACTION=CONFIGURE_TOTP
VITE_GRAPHQL_URL=http://localhost:30000/graphql

# Where client-gui fetches a widget from. The SDK is given the base address and
# owns the path, so this has no /widgets on the end. The field on the page is
# editable, so this is only what it starts on.
VITE_WIDGET_API_URL=http://localhost:30000

########################################################################
# MAIL (Mailpit - development only)
#
# Keycloak needs an SMTP server to send a password-reset link. Mailpit
# accepts everything and delivers nothing: the message stops at its web
# inbox, so a reset can be tested without mail leaving the machine.
########################################################################

MAIL_ADDRESS=main-mail
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
MAIL_UI_PUBLISHED_PORT=30004

# main-api sends its own mail now too, for the address verification on the
# security page. It reaches the same Mailpit container on the same port, so
# the whole of that is MAIL_ADDRESS and MAIL_SMTP_PORT above; what is here is
# what a message says it is from, and where the link in it points.
#
# MAIL_FROM_ADDRESS matches the realm's smtpServer.from, so verification mail
# and Keycloak's own password-reset mail come from the same place. The domain
# is reserved and unroutable on purpose.
MAIL_FROM_ADDRESS=no-reply@northwind.test
MAIL_FROM_NAME=Front Runner

# Where a verification link lands. The browser's address for main-gui, not the
# Compose one: this goes into an email somebody opens on their own machine.
APP_BASE_URL=http://localhost

########################################################################
# APPLICATION SECRETS
########################################################################

ENVIRONMENT=dev

# What main-api hands dbo.AddCreditCard and dbo.AddBankAccount to encrypt a
# card or account number with. It is never written into the database, which is
# the whole point of it -- a dump of dbo.CreditCards is not a list of card
# numbers. This one is a committed development key and protects nothing; a real
# deployment sets its own and keeps it somewhere a repository is not.
#
# The number columns and this key are a placeholder for a payment processor and
# are meant to be deleted together. See apps/main-db/sql/Tables/CreditCards.sql.
WALLET_ENCRYPTION_KEY=dev-wallet-key-not-a-secret

########################################################################
# TEXT MESSAGES (Twilio)
#
# The SMS second factor, and the one feature in this repository that is
# deliberately switched off until somebody buys a phone number. With these
# three empty, main-api reports SMS unavailable, the security page draws the
# row and says so, and nothing is ever sent. Fill all three in and it works;
# two out of three is read as none, because a card offering a factor nobody
# can finish setting up is worse than a card that says it is not available.
########################################################################

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The shared secret on the one route Keycloak calls into main-api: the SMS
# authenticator asks for a login code to be carried to a number, because the
# decision belongs to Keycloak and the Twilio credentials belong to main-api.
# See apps/keycloak-idp/plugin and apps/main-api/src/sms.
#
# Development value only, and it is a real secret in a deployment: whoever has
# it can make this API send a text message. With it empty, main-api refuses
# every caller on that route rather than admitting them, so SMS logins stop
# working and nothing else does.
SMS_GATEWAY_SECRET=dev-sms-gateway-secret-not-a-secret

# Where the authenticator finds that route. The Compose address, because this
# call is made by Keycloak inside the network rather than by a browser.
SMS_GATEWAY_URL=http://main-api:3000/internal/sms/second-factor
