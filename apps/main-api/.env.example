NODE_ENV=development
API_PORT=3000
# For host development, use the published database address and port.
POSTGRES_ADDRESS=127.0.0.1
POSTGRES_PORT=30002
POSTGRES_DATABASE=dbo
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_POOL_SIZE=10
POSTGRES_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost,http://localhost:5173
# Keycloak. The issuer must match the token's "iss" exactly -- it is the
# address the browser signed in at, not the one this process reaches Keycloak
# on. HTTPS is required when NODE_ENV=production.
KEYCLOAK_ISSUER_URL=http://localhost:30003/realms/front-runner
# Where the signing keys are fetched from. Optional: it defaults to
# <issuer>/protocol/openid-connect/certs, which is right on the host and wrong
# inside Compose, where the issuer is a published port this process cannot use.
KEYCLOAK_JWKS_URL=http://localhost:30003/realms/front-runner/protocol/openid-connect/certs
# The client id this API is an audience for. A token minted for anything else
# is rejected even when the realm signed it.
KEYCLOAK_AUDIENCE=main-api
