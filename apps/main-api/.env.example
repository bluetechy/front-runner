NODE_ENV=development
API_PORT=3000
# For host development, use the published database address and port.
POSTGRES_ADDRESS=127.0.0.1
POSTGRES_PORT=30002
POSTGRES_DATABASE=dbo
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_POOL_SIZE=10
POSTGRES_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost,http://localhost:5173
# The identity provider, whichever one it is. The issuer must match the
# token's "iss" exactly -- it is the address the browser logged in at, not the
# one this process reaches the provider on. HTTPS is required when
# NODE_ENV=production.
IDP_ISSUER_URL=http://localhost:30003/realms/front-runner
# Where the signing keys are fetched from. Optional: it defaults to
# <issuer>/protocol/openid-connect/certs, which is Keycloak's path, right on
# the host and wrong inside Compose, where the issuer is a published port this
# process cannot use. Any provider publishes its own at
# <issuer>/.well-known/openid-configuration.
IDP_JWKS_URL=http://localhost:30003/realms/front-runner/protocol/openid-connect/certs
# The client id this API is an audience for. A token minted for anything else
# is rejected even when the provider signed it.
IDP_AUDIENCE=main-api
# What the provider stamps an access token's "typ" with, so that an ID token
# cannot be spent as one. Optional: Keycloak writes "Bearer", which is the
# default; empty turns the check off.
IDP_ACCESS_TOKEN_TYPE=Bearer
# What a saved card or bank account number is encrypted under, by
# dbo.AddCreditCard and dbo.AddBankAccount. Required, at least 16 characters,
# and never stored in the database -- keeping it out of there is the only
# reason encrypting the column is worth anything. A placeholder for a payment
# processor, and meant to be deleted with the columns it protects.
WALLET_ENCRYPTION_KEY=replace-with-your-local-wallet-key
# Whether refused logins are mirrored out of the identity provider's event log
# onto the security page. Optional, on by default. The one event type on that
# page with a switch, because it is the one nothing deduplicates: ten attempts
# are ten rows, and a realm being scanned can fill somebody's page. Turning it
# off stops the polling entirely; the provider keeps its own event log either
# way. true/1/yes/on and false/0/no/off are all understood.
SECURITY_LOG_FAILED_LOGINS=true
