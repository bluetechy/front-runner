NODE_ENV=development
API_PORT=3000
# For host development, use the published database address and port.
POSTGRES_ADDRESS=127.0.0.1
POSTGRES_PORT=30002
POSTGRES_DATABASE=dbo
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_POOL_SIZE=10
POSTGRES_STATEMENT_TIMEOUT_MS=10000
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost,http://localhost:5173
# Optional: login is unavailable until BOTH values are configured.
# Existing installations used https://hydraqa.unicity.net/v5a-test
# and https://hydraqa.unicity.net/v5a-test/employees respectively.
# HYDRA_BASE_URL=https://your-identity-provider.example/v5a
# HYDRA_NAMESPACE=https://your-identity-provider.example/v5a/employees
