{
  "name": "front-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Gamification Project monorepo",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:changed": "node scripts/test-changed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:tests": "node scripts/check-tests.mjs",
    "lint": "npm run format:check && npm run lint:js && npm run lint:tests && turbo run lint"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "turbo": "^2.5.8"
  },
  "packageManager": "npm@11.6.2"
}
